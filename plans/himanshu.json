  "rules": [
    "Never round the lower back under load. Brace lightly every set.",
    "Avoid: barbell back squat, floor deadlift, standing barbell OHP, bent-over barbell row, good mornings, weighted sit-ups/twists.",
    "No heavy training in the first hour after waking.",
    "Stop on any pain, numbness or tingling into the buttock or leg."
  ],
  "progression": [
    "Double progression: add reps each week; when all sets hit the top of the range, add the smallest load.",
    "1–2 reps in reserve on compounds, 0–1 on isolations. Never grind under spinal load.",
    "Rest 2–3 min on compounds, 60–90 s on isolations.",
    "Deload (half the volume) every 6–8 weeks."
  ],
