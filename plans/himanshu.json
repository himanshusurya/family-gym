  "warmup": {
    "min": 8,
    "steps": [
      "5 min incline walk or bike",
      "Glute bridge ×15 · Bird-dog ×8/side · Band pull-apart ×20 · Dead bug ×8/side",
      "Lower days: a few bodyweight squats + banded lateral walks ×10/side",
      "2 ramp-up sets on the first compound"
    ]
  },
  "finish": [
    {
      "title": "Cardio (Tue, Thu, Fri)",
      "min": 25,
      "text": "Incline walk or bike, Zone 2 (you can still talk). Plus 8–10k steps every day, weekends included."
    }
  ],
  "rules": [
    "Never round the lower back under load. Brace lightly every set.",
    "Avoid: barbell back squat, floor deadlift, standing barbell OHP, bent-over barbell row, good mornings, weighted sit-ups/twists.",
    "No heavy training in the first hour after waking.",
    "Stop on any pain, numbness or tingling into the buttock or leg.",
    "Missed a day? Do the next session in order the next day. In a short week, drop Friday first: Mon–Thu already trains everything twice.",
    "Short on time? Do the first 4 exercises (marked ★). That is the minimum session.",
    "Saturday and Sunday: rest, plus walking."
  ],
  "progression": [
    "Week 1 of v5 is a re-entry week: 2 sets per exercise, about 10% lighter, 3 reps in reserve.",
    "Then double progression: add reps each week; when all sets hit the top of the range, add the smallest load.",
    "Effort: compounds 1–2 reps in reserve; isolations (laterals, curls, extensions, leg curl, calves, flyes) to true failure on the last set. Never grind under spinal load.",
    "Every rep: 2–3 s lowering, full stretch at the bottom, no bouncing.",
    "Rest 2–3 min on compounds, 60–90 s on isolations. Supersets marked \"SS\" save time.",
    "Deload (half the sets) every 6th week, or after any gap of 7+ days."
  ],
