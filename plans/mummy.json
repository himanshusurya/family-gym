  "rules": [
    "Breathe out on the effort. Never hold your breath.",
    "No sit-ups, crunches, twisting with weight, toe-touch stretches or jumping (until the bone-density test says OK).",
    "Leg and back exercises build bone: increase their weight steadily.",
    "Warm up gradually. Keep the inhaler in the bag if you use one. Stop if you wheeze.",
    "Tell Himanshu about any tingling, numbness or unsteadiness.",
    "Get up slowly from lying or seated positions.",
    "Stop and sit down on chest pain, unusual breathlessness, dizziness or joint pain."
  ],
  "progression": [
    "Weeks 1–2: 1–2 light sets × 12–15 reps. Just learn the form.",
    "Weeks 3–8: the sets below, stopping with 3–4 reps left.",
    "Add weight when every set reaches the top of the rep range with good form.",
    "Every 8th week: halve the sets (recovery week)."
